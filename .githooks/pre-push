#!/usr/bin/env bash
#
# Runs the same checks CI runs, before anything leaves the machine.
# CI's `linter` job runs `uv run poe lint`; its test jobs run `uv run poe
# test-only`. `poe test` is the sequence of both, so a green hook means a
# green CI (modulo the macOS/Windows test matrix).
#
# Bypass for an emergency push with:  git push --no-verify
set -euo pipefail

# GUI git clients (VSCode, IDEs, Tower) start from a minimal PATH that is
# missing the usual user-local bin dirs, so `uv` would not be found.
if ! command -v uv >/dev/null 2>&1; then
    PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
    export PATH
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-push: uv not found on PATH; cannot run checks." >&2
    echo "pre-push: install uv, or push with --no-verify to skip." >&2
    exit 1
fi

# Nothing to verify when every ref in this push is a deletion.
all_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in
        *[!0]*) all_deletes=0 ;;
    esac
done
if [ "$all_deletes" -eq 1 ]; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running 'uv run poe test' (lint + unit tests)..."
if ! uv run poe test; then
    echo >&2
    echo "pre-push: checks failed - push aborted." >&2
    echo "pre-push: 'uv run poe fmt' auto-fixes import order and formatting." >&2
    echo "pre-push: note that poe stops at the first failing subtask, so fix" >&2
    echo "pre-push: and re-run to reveal any checks hiding behind it." >&2
    echo "pre-push: to push anyway: git push --no-verify" >&2
    exit 1
fi
